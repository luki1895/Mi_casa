# Conexion a PostgreSQL en Supabase
DATABASE_URL=

# Clave aleatoria para firmar tokens JWT; configurala fuera del repositorio.
JWT_SECRET=

# Ruta local del certificado raiz SSL (absoluta o relativa a backend)
PGSSLROOTCERT=prod-ca-2021.crt

# En Vercel, se puede configurar el PEM completo en runtime en lugar del archivo.
# Esta variable tiene prioridad sobre PGSSLROOTCERT.
PGSSLROOTCERT_PEM=

# URL publica del backend para el frontend
# VITE_API_URL=http://localhost:3000/api
# VITE_API_URL=https://tu-backend.vercel.app/api
